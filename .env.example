APP_NAME=Ruhscans
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ruhscans
DB_USERNAME=ruhscans
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@ruhscans.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_DEFAULT_REGION=auto
R2_BUCKET=
R2_URL=
R2_ENDPOINT=
R2_USE_PATH_STYLE_ENDPOINT=false

ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

CONTENT_IMAGE_DISK=r2
CONTENT_WEBP_QUALITY=82
CONTENT_MAX_ZIP_KB=204800
CONTENT_MAX_IMAGE_KB=20480
CONTENT_MAX_PAGE_HEIGHT=16000
CONTENT_MAX_PAGE_WIDTH=1600
CONTENT_MAX_COVER_KB=10240
CONTENT_COVER_MIN_WIDTH=300
CONTENT_COVER_MIN_HEIGHT=450
CONTENT_COVER_MAX_WIDTH=6000
CONTENT_COVER_MAX_HEIGHT=9000
CONTENT_DIRECT_UPLOAD_THRESHOLD_KB=100000
CONTENT_DIRECT_UPLOAD_TTL=30
CONTENT_MAX_ZIP_FILES=500
CONTENT_MAX_ZIP_UNCOMPRESSED_KB=512000
CONTENT_MAX_ZIP_RATIO=200
CONTENT_COVER_CACHE_TTL=31536000
CATALOG_HOME_TTL=300
CATALOG_TAGS_TTL=900
CONTENT_SEARCH_SIMILARITY=0.2
CONTENT_PAGE_URL_TTL=5
CONTENT_WATERMARK=false
READ_RATE_PER_MINUTE=40
READ_BURST_WINDOW=10
READ_BURST_MAX=12
READ_BLOCK_MINUTES=15
HOTLINK_HOSTS=
TRUSTED_PROXIES=
SECURITY_HSTS=true

CODE_HMAC_KEY=
SONTEKLIF_URL=https://www.sonteklif.com

# Cloudflare Turnstile — gerçek anahtarları ASLA commit etmeyin.
# Resmi test anahtarları (her zaman geçerli, üretimde kullanmayın):
#   Site key:  1x00000000000000000000AA  (her zaman görünür geçer)
#   Secret:   1x0000000000000000000000000000000AA  (her zaman doğrulanır)
#   Site key:  2x00000000000000000000AB  (her zaman görünür başarısız)
#   Secret:   2x0000000000000000000000000000000AB  (her zaman doğrulama başarısız)
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

VITE_APP_NAME="${APP_NAME}"
